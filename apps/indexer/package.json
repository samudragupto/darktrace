{
  "name": "@darktrace/indexer",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "tsx --test src/pipeline.test.ts src/onchain.test.ts src/linked.test.ts",
    "process-tx": "tsx src/process-tx.ts",
    "claim": "tsx src/claim.ts",
    "e2e-sandwich": "tsx src/e2e-sandwich.ts"
  },
  "dependencies": {
    "@darktrace/arkiv": "workspace:*",
    "@darktrace/simulator": "workspace:*",
    "dotenv": "^16.4.5",
    "viem": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "esbuild": "^0.21.3",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
