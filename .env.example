# Arkiv network (rabdi testnet, chain 7794095)
ARKIV_RPC_URL="https://rpc.rabdi.db-chain.testnet.arkiv.network"
ARKIV_CHAIN_ID="7794095"
ARKIV_ACCESS_KEY="<get from https://hub.arkiv.network/access-keys>"
# Private key of the writer wallet — needed only by the indexer / write-test (never by the web app)
ARKIV_PRIVATE_KEY="<0x… 32-byte key of the writer wallet>"
# Address whose entities the web app trusts on read (defaults to the DarkTrace writer)
ARKIV_WRITER_ADDRESS="0xb491fe5846DE735B6Cb03a677A3C6296FAB0aDA5"
# Optional dev override — leave unset in production
# ARKIV_DEV_MODE="memory"

# Arc Testnet (chain 5042002)
NEXT_PUBLIC_ARC_RPC_URL="https://rpc.testnet.arc.network"
NEXT_PUBLIC_ARC_CHAIN_ID="5042002"
NEXT_PUBLIC_REBATE_VAULT="0x238dE56E52A3F6C6708952052e6a20E5102b4d5b"
NEXT_PUBLIC_SIMULATION_REGISTRY="0xd501D47b246438A18C8a0BFFCF10338CfBB661a2"
NEXT_PUBLIC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# Base Sepolia (chain 84532)
